    "Sopir taksi" "\" Thanks sir, have a good day.\""

translate id inttaxi_b7b97f67:
    mcmind "Saya senang telah tiba, perjalanan ini melelahkan."

translate id intofficeph_3a8e9a7d:
    bro "Halo, Alan Stevens berbicara, tolong tunggu sebentar."

translate id intofficeph_15542eea:
    bro "Hei sayang, bawakan kopi, kamu akan baik-baik saja."

translate id intofficeph_28b3c135:
    bro "{size=15}...Tidak pernah bosan dengan itu...{size=30}"

translate id intofficeph_e8f710da:
    bro "Jadi, siapa yang berbicara dan apa yang bisa saya bantu?"

translate id intofficeph_c461101e:
    mc "Alan ini aku, [player]."

translate id intofficeph_d1f79afe:
    bro "Oh itu kamu, apa yang kamu inginkan?"

translate id intofficeph_e04124ee:
    mc "Aku di bandara aku menunggu seseorang menjemputku."

translate id intofficeph_0e393057:
    bro "Oh kamu sudah sampai di sana? Baiklah aku yang mengurusnya!"

translate id intofficeph_d3d86ce2:
    mc "Oke jadi kamu..."

translate id intofficeph_4c5b6784:
    mc "Halo.....Alan..."

