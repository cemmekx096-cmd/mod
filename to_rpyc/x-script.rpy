translate id d9evening_a0fe903e:
    centered "{=bl_sc_style} Setelah Alan dan Jennifer pergi, Anda tetap berada di depan TV lebih lama."

translate id d9evening_b9e89921:
    centered "{=bl_sc_style} Lalu, setelah beberapa saat, matikan semuanya di lantai bawah dan naik ke atas untuk tidur."

translate id d9night_723cc317:
    "Tapi sebelum tidur, kamu harus berdandan seperti biasa."

translate id d9night_9676cc2d:
    "Jadi setelah berganti pakaian tidur, kamu pergi ke kamar mandi untuk ke toilet sebentar dan gosok gigi."

translate id d9night_0b6fd490:
