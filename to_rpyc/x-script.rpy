    mc "42 Jalan Richmond di Lake Hill."

translate id inttaxi_2d0bacf0:
    "Sopir taksi" "\" Ok, perfect! Get in the car.\""

translate id inttaxi_f0649462:
    "Sopir Taksi" "\" So may I ask you what you are doing here, if it's not too personnal?\""

translate id inttaxi_5a8ef37e:
    "Sopir Taksi" "\" Tourism?{w=1} Business?{w=1} Came to visit a girl?\""

translate id inttaxi_fb5437a9:
    mc "Sebenarnya, aku akan pulang setelah aku lulus."

translate id inttaxi_c2407a23:
    "Sopir Taksi" "\" Studying in another city, away from parents, it must have been so cool!\""

translate id inttaxi_c07d177a:
    mc "Sebenarnya sekolahku berada di negara lain, di Eropa."

translate id inttaxi_6eab1ac5:
    "Sopir Taksi" "\" Wow, nice! Girls in europe are so kinky.\""

