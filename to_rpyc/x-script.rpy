translate id d10swimshow_83cf1494:
    bl "Dan kamu bahkan belum melihat milikku. Jika menurut Anda ini terlalu berlebihan bagi Anda, kita bisa berhenti di sini. Anggap saja aku menang."

translate id d10swimshow_4de50770:
