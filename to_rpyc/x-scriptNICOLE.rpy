translate id noel_s01_a3034822:


    ja "Oh ya!"


translate id noel_s01_abd6c8fa:


    ni "[jason], hati-hati!"


translate id noel_s01_68b9f115:


    nip p "Saya lebih suka tidak menghabiskan malam Natal di Ruang Gawat Darurat..."


translate id noel_s01_36103d81:


    ja "Jangan khawatir, Bu, saya dapat ini..."


translate id noel_s01_d1893f6a:


    jen "Mama! Apakah kita akan segera pulang?{w} Aku kedinginan di sini!"


translate id noel_s01_1277befa:


    ni "Sedikit lagi, sayang. Adikmu perlu bermain lagi."


translate id noel_s01_08edd1a3:


    ni "Lihat dia! Dia bersenang-senang."


translate id noel_s01_4dc8d130:


    ni "Kami tidak mendapat banyak salju, jadi kami harus memanfaatkan kesempatan ini."


translate id noel_s01_48f1e920:


    ni "Namun, hari sudah mulai gelap, jadi tidak akan lama lagi.{w} Juga...salju mulai turun."


translate id noel_s01_7b51be2a:


    ni "Dan kami masih harus menyiapkan segalanya untuk makan malam Natal kami."


translate id noel_s01_73abdbc5:


    ni "Mengapa kamu tidak pergi bermain dengan kakakmu daripada hanya berdiri di sana sambil menggigil? Saya yakin dia akan menyukainya."


translate id noel_s01_45186c80:


    jen "[jason], kemarilah!{w} Aku akan naik kereta luncur bersamamu sebelum kita pulang."


translate id noel_s01_7406beed:


    ja "Keren!{w} Saya ikut!"


translate id noel_s01_0e48f3fb:


    ni "Oke...pegang erat-erat!{w} Ini dia."


translate id noel_s01_7b0dd8fd:


    jen "Yaaaaahhhh!"


translate id noel_s01_afeb9350:


    ja "Wah!"


translate id noel_s01_102dd221:


    ja "Dorong lebih keras, Bu! Lebih cepat!"


translate id noel_s01_f36de6cb:


    ja "Wah! Yaaaaahhhh!"


translate id noel_s01_b832e55b:


    jen "Kita akan jatuh!{w} Kita akan jatuh!"


translate id noel_s01_b60bb375:


    jen "Tidaaaak!"


translate id noel_s01_fe7fccf4:


    ja "Aaaaaahhhhh!"


translate id noel_s01_d52f51b6:


    ni "Lihat kalian berdua! Berantakan sekali."


translate id noel_s01_15a04fac:


    ni "Kamu akan basah kuyup!"


translate id noel_s01_2feb97e1:


    jenp p "Apa-apaan ini?{w} Apa bocah cilik itu membuatku kesal?"


translate id noel_s01_5920c2f1:


    jap p "Mmmm...sangat bagus...sangat lembut."


translate id noel_s01_1cb6716d:


    jen "Lepaskan tanganmu, [jason]!{w} Astaga, apa yang merasukimu?"


translate id noel_s01_fb037939:


    jen "Dasar anak mesum...{w}raba ini!"


translate id noel_s01_b5d9354d:


    nip p "Benar-benar pembuat onar.{w} Sepertinya dia selalu menemukan cara untuk memprovokasi adiknya!"


translate id noel_s01_b10e338c:


    ni "Ayo anak-anak, waktunya berangkat!"


translate id noel_s01_76d82d6a:


    ni "Aku akan menunggumu di dalam mobil."


translate id noel_s01_8aa465bb:


    ja "Mama! Saya perlu buang air kecil!"


translate id noel_s01_9e3a8f3f:


    jen "Saya pikir saya telah berubah menjadi es!"


translate id noel_s01_13a5ffa2:


    ni "Kencinglah di balik pohon itu."


translate id noel_s01_a342d684:


    jen "Sebaiknya aku melakukan 'kencing aman' juga."


translate id noel_s01_a2810539:


    jen "Saya akan melakukannya di belakang mobil."


translate id noel_s01_8de27039:


    ni "Oke, sayang."


translate id noel_s01_84ab21c2:


    ni "Saya akan menunggu di mobil dan menghangatkan pemanasnya."


translate id noel_s01_a1ce6fda:


    ja "Hai ibu! Saya bisa menulis nama saya di salju!"


translate id noel_s01_f8d5892b:


    nip p "Anakku...{w}begitu banyak energi dalam paket sekecil ini!"


translate id noel_s01_f5e20607:


    nip p "Nona kecilku...{w}betapa cepatnya dia tumbuh dewasa!"


translate id suiteNoelS01_68241453:


    nip p "Apa yang dia lakukan sekarang?"


translate id suiteNoelS01_07b0c68e:


    nip p "Aku yakin dia berencana mengacaukan adiknya."


translate id suiteNoelS01_6532131a:


    jap p "Dia tidak akan melihat yang ini datang!"


translate id suiteNoelS01_44584dcf:


    jap p "Siap..."


translate id suiteNoelS01_d5b03382:


    jap p "Mengatur..."


translate id suiteNoelS01_1b6f150d:


    jap p "PERGI!"


translate id suiteNoelS01_0b20df08:


    ja "[jennifer]!{w} Di sini!"


translate id suiteNoelS01_afd65115:


    jenp p "Keparat!"


translate id suiteNoelS01_6e67aea1:


    jenp p "Tidak bisakah aku buang air kecil dengan tenang?"


translate id suiteNoelS01_d8b8886b:


    jen "OOOWWWWWWW!"


translate id suiteNoelS01_8ca52728:


    jap p "Ups."


translate id suiteNoelS01_70c01ace:


    jap p "Dia akan membunuhku..."


translate id suiteNoelS01_87c870b2:


    jenp p "aku akan membunuhnya..."


translate id suiteNoelS01_c2a28e19:


    jen "[jason]! Dasar bajingan kecil yang menyebalkan!{w} Tinggalkan aku sendiri!"


translate id suiteNoelS01_78731e42:


    nip p "Segalanya menjadi tidak terkendali! Sebaiknya aku turun tangan sebelum keadaan menjadi buruk."


translate id suiteNoelS01_949872a4:


    nip p "Sayang...kau tahu, menurutku ini waktunya kita bicara sedikit tentang, um, \'mencukur rambut pribadi\'."


translate id suiteNoelS01_349c18b8:


    ni "[jason], masuk ke dalam mobil."


translate id suiteNoelS01_e29c377c:


    ni "Apakah menurut Anda Sinterklas akan menyetujui perilaku tersebut?"


translate id suiteNoelS01_ab10657b:


    ni "Jangan datang kepadaku sambil menangis besok pagi ketika kamu tidak menemukan hadiah apa pun di bawah pohon Natal."


translate id suiteNoelS01_4b534226:


    ja "Tapi Bu, aku tidak melakukan apa pun."


translate id suiteNoelS01_d8ab20eb:


    ni "Masuk ke mobil sekarang!"


translate id suiteNoelS01_e2660f98:


    ja "Pfffffft!"


translate id suiteNoelS01_94375f32:


    jap p "Santa bahkan tidak nyata..."


translate id suiteNoelS01_1e7b248c:


    ni "Jangan menggerutu!"


translate id suiteNoelS01_2b86cf83:


    ni "Apakah kamu baik-baik saja, sayang?"


translate id suiteNoelS01_013512bc:


    ni "Ayo, pulang.{w} Kita akan minum teh, mandi air hangat, dan bersiap untuk malam ini."


translate id suiteNoelS01_1ea74f43:


    jen "Aku tidak tahan lagi dengannya!"


translate id suiteNoelS01_2a26b710:


    jen "Suatu hari nanti, jika dia terus melakukannya, aku akan memukulnya dengan keras!"


translate id suiteNoelS01_f2694953:


    ni "Dia masih anak-anak,{w} dan lagipula, ini hari Natal..."


translate id suiteNoelS01_f528c1fc:


    ni "Dia hanya bersemangat. Itu sebabnya dia bertingkah.{w} Cobalah untuk tidak terlalu keras padanya."


translate id suiteNoelS01_0f0f07b2:


    jen "Setidaknya kamu harus membiarkan aku memukulnya lain kali. Maksudku, untuk menyamakan skor sedikit."


translate id suiteNoelS01_bfed83b9:


    ni "Ayo masuk ke mobil."


translate id suiteNoelS01_0038ed53:


    ni "Anda tahu bahwa kekerasan tidak diperbolehkan di rumah kami."


translate id suiteNoelS01_5c66fa4a:


    ni "Tapi...kamu diperbolehkan untuk membela diri."


translate id noel_s02_36505b55:


    jen "[jason] sedang tertidur."


translate id noel_s02_cfeebb69:


    jen "Dia agak lucu...{w}saat dia tidur."


translate id noel_s02_365c01ef:


    ni "Saya yakin Anda tidak ingat, tapi dia sebenarnya sama seperti Anda pada usia itu."


translate id noel_s02_b10f14b0:


    ni "Ketika Anda masih kecil, Anda selalu membuat teman-teman Anda gila."


translate id noel_s02_45ba6605:


    ni "Ingatkah Anda saat Anda mengumpulkan belalang dari lahan kosong dekat rumah kita?"


translate id noel_s02_20d403c4:


    jen "Aduh! belalang?"


translate id noel_s02_5dfd4b0a:


    jen "Apakah kamu yakin itu aku?"


translate id noel_s02_98d55983:


    jen "Tunggu sebentar,{w} apakah kita sedang membicarakan makhluk menjijikkan dengan banyak kaki yang melompat-lompat?"


translate id noel_s02_1493a8fd:


    ni "Ya, itulah tepatnya yang sedang kita bicarakan!{w} Belalang."


translate id noel_s02_2678d8be:


    ni "Itu tidak menjijikkan bagimu ketika kamu berumur sembilan tahun."


translate id noel_s02_07bfbea6:


    ni "Anda biasa mengambilnya dengan tangan kosong...Anda mengisi sebuah kotak kecil."


translate id noel_s02_7fd0ad90:


    jen "Dan apa yang saya lakukan terhadap semua bug itu?"


translate id noel_s02_a9551c32:


    jen "Saya tidak ingat apa pun tentang ini.{w} Ini gila!"


translate id noel_s02_41c16226:


    ni "Anda entah bagaimana mengira belalang akan memakan semua pakaiannya dan dia tidak punya apa-apa lagi untuk dipakai ke sekolah keesokan harinya."


translate id noel_s02_fdcf0f1e:


    jen "Itu mengerikan!"


translate id noel_s02_50e68f0f:


    jen "Apakah aku benar-benar melakukan itu?"


translate id noel_s02_21fed52d:


    ni "Ya, benar!"


translate id noel_s02_229ac810:


    ni "Ibunya mengunjungiku dengan ramah."


translate id noel_s02_566d520e:


    ni "Dia sebenarnya lebih terkejut dari putrinya..."


translate id noel_s02_f7e2e3f1:


    ni "Rupanya, belalang berhasil menemukan jalan keluar dari laci dan menyerbu kamar kecil Samantha."


translate id noel_s02_5d8317bd:


    ni "Mereka merangkak kemana-mana!"


translate id noel_s02_205d9341:


    jen "Bagaimana akhirnya?"


translate id noel_s02_992131c9:


    ni "Ayahmu harus pergi ke sana dan mengumpulkan semuanya."


translate id noel_s02_cb3a8a49:


    jen "Oh tidak! Kemudian?"


translate id noel_s02_51e65c4b:


    ni "Dia benar-benar marah...{w}tapi tidak padamu."


translate id noel_s02_033affee:


    ni "Apa pun yang biasa Anda lakukan, dia tidak akan pernah marah atau membentak Anda."


translate id noel_s02_3f47bccc:


    ni "Dan sekarang saya melakukan hal yang persis sama dengan [jason]."


translate id noel_s02_b4f78683:


    ni "Saya mencoba membesarkannya seperti yang diinginkan ayahnya."


translate id noel_s02_f488a9d4:


    ni "Aku tahu betapa menyebalkannya dia terhadapmu,{w} tapi pada akhirnya dia akan melupakannya."


translate id noel_s02_f4c4cba7:


    ni "Anda hanya perlu menjelaskan kepadanya mengapa apa yang dia lakukan salah."


translate id noel_s02_6bd9cd9a:


    jap p "Wah, payudara besar!"


translate id noel_s02_d60a1582:


    jap p "Aku ingin tahu apakah mereka lebih besar dari milik ibu?"


translate id noel_s02_54c5c70b:


    centered "{size=50}{cps=20}{font=RobotoSlab-Bold.TTF}45 menit kemudian...{/font}{/cps}{/size}{w=3}{nw}" with dissolve


translate id noel_s02_12c87690:


    jen "Mama?"


translate id noel_s02_87e08e6f:


    jen "Apakah [jason] benar-benar percaya bahwa Sinterklas itu nyata?"


translate id noel_s02_f2c2dd02:


    ni "Saya cukup yakin dia melakukannya!"


translate id noel_s02_200cc6db:


    jen "Mustahil...! Kamu tidak mungkin serius!{w} Kamu bercanda kan?"


translate id noel_s02_a5bf6dc7:


    jen "Saya rasa saya tidak lagi percaya pada Santa pada usia itu."


translate id noel_s02_c2965882:


    ni "Namun, aku dengan patuh terus membelikan hadiah Natal untukmu setiap tahun..."


translate id noel_s02_336a485f:


    ni "Ketika kamu masih muda,{w} ayahmu dan aku akan melakukan apa pun semampu kami untuk memberimu Natal yang luar biasa."


translate id noel_s02_c838162f:


    ni "Pohon,{w} lampu,{w} dekorasi..."


translate id noel_s02_72ab68e5:


    ni "Semangat Natal membuat segalanya ajaib sepanjang tahun ini."


translate id noel_s02_d30d23b0:


    ni "Anda akan berbicara tentang Natal selama berbulan-bulan sebelumnya."


translate id noel_s02_8975a391:


    ni "Anda menulis surat kepada Santa untuk memberi tahu dia hadiah apa yang Anda inginkan."


translate id noel_s02_6a6a6f89:


    ni "Dan saya tidak diizinkan membacanya."


translate id noel_s02_b54fd32d:


    ni "Untuk memastikan kerahasiaan antara Anda dan Sinterklas, Anda mengirimkannya sendiri melalui pos...{w}tanpa prangko, saya dapat menambahkan."


translate id noel_s02_93bc02d7:


    ni "Anda selalu bersikeras agar kami meninggalkan segelas susu untuk Santa."


translate id noel_s02_22af3fdc:


    ni "Dan kue, kalau-kalau dia lapar. Dan tentu saja jangan lupa wortel untuk rusa..."


translate id noel_s02_469bc875:


    jen "Sepertinya aku ingat itu!"


translate id noel_s02_ecaa8a27:


    jen "Anda menunggu sampai saya tertidur, lalu menggigit wortel dan meminum sedikit susu..."


translate id noel_s02_3a6ac14e:


    ni "Pernahkah aku memberitahumu tentang hal itu saat kita TIDAK melakukannya?"


translate id noel_s02_42ac3d6e:


    ni "Ayahmu dan aku tidur lebih awal dari biasanya...kami sedikit mabuk."


translate id noel_s02_060117bb:


    ni "Anda datang untuk membangunkan kami saat fajar.{p}Anda tidak dapat menunggu lebih lama lagi untuk membuka hadiah Anda."


translate id noel_s02_e5383084:


    ni "Kamu sangat bersemangat."


translate id noel_s02_044ed12d:


    jen "Saya mengerti ke mana arahnya. Anda akan memberi tahu saya bahwa wortelnya hilang dan gelas susunya kosong, bukan?"


translate id noel_s02_9a61bed3:


    ni "Ya!{w} Itulah yang terjadi."


translate id noel_s02_5bca04fb:


    jen "Ha ha!{w} Dasar anak nakal, Bu..."


translate id noel_s02_d130d105:


    ni "Aku berjanji aku tidak bercanda, sayang."


translate id noel_s02_50301ea6:


    jen "Kalau begitu, kalian berdua pasti lebih dari sekadar 'mabuk' malam itu!"


translate id noel_s02_647b5821:


    ni "Hmph...jadi, apakah kamu ingat boneka hitam dan biru yang kamu dapatkan di Hari Natal itu?"


translate id noel_s02_1984c5a1:


    jen "Tentu saja aku tahu! Dia sangat cantik..."


translate id noel_s02_8e3c8a7c:


    jen "Dia adalah boneka yang selalu aku impikan."


translate id noel_s02_f26769c4:


    ni "Ya...kami tentu saja tidak membelikannya untukmu!{p}Ayahmu dan aku sama terkejutnya melihatnya seperti kamu."


translate id noel_s02_8cfbdbc1:


    jen "Ya benar!"


translate id noel_s02_88fada76:


    ni "ITULAH keajaiban Natal!"


translate id noel_s02_64c33c6a:


    jenp p "Sebenarnya, jika kuingat kembali ke masa itu, sebenarnya aku sendiri yang menggambar boneka itu."


translate id noel_s02_ecd53713:


    jenp p "Boneka aslinya tampak persis seperti gambar saya."


translate id noel_s02_47228f09:


    jenp p "Ibu dan Ayah tidak mungkin mengetahui hal itu."


translate id noel_s02_b408878f:


    jenp p "Ibu sangat pandai membuatku bertanya-tanya..."


translate id noel_s02_898cb749:


    jap p "Apakah itu berarti Santa memang ada?"


translate id noel_s02_a69c5ca9:


    jap p "Saya perlu memahami hal ini sampai tuntas."


translate id noel_s02_3220e5e9:


    jen "Anda tahu apa? Kamu sangat pandai bercerita, Bu.{p}Aku hampir mempercayaimu."


translate id noel_s02_1cbae195:


    jen "But the \"magic of Christmas\"hal itu tidak lagi berhasil pada saya.{w} Saya sudah terlalu tua untuk melakukan hal itu sekarang."


translate id noel_s02_ab771657:


    ni "Cobalah untuk memercayainya lagi!{w} Anda akan melihatnya sendiri..."


translate id noel_s02_e10c9059:


    ni "Anda tahu apa yang saya pikirkan...{p}seiring berjalannya waktu,{w} dan orang-orang bertambah dewasa,{w} mereka tidak lagi percaya pada lelaki tua yang mengantarkan hadiah pada malam Natal."


translate id noel_s02_0bfeb6c0:


    ni "Untuk menjaga keajaiban tetap berjalan, karena takut anak-anak tidak akan menemukan hadiah apa pun di bawah pohon Natal di pagi hari, orang tua keluar dan membeli hadiah untuk diletakkan di bawahnya."


translate id noel_s02_49bb16fc:


    ni "Dengan melakukan itu, mereka menghilangkan keajaiban Natal itu."


translate id noel_s02_13d1a672:


    ni "Dengar,{w} coba ingat kata-kata yang biasa Anda ucapkan kepada Sinterklas, dan coba bicara lagi dengannya.{w} Anda mungkin akan terkejut..."


translate id noel_s02_1d536984:


    centered "{size=50}{cps=20}{font=RobotoSlab-Bold.TTF}...{/font}{/cps}{/size}{w=3}{nw}" with dissolve


translate id noel_s02_b56a81c9:


    ni "Akhirnya...kita sampai di rumah."


translate id noel_s02_f54ead90:


    ni "Mari kita istirahat sebentar dan mulai mempersiapkan pesta malam ini."


translate id noel_s02_5c96711d:


    jen "Dan keluarlah dari pakaian basah ini!"


translate id noel_s02_eb262e74:


    ni "Tolong bangunkan adikmu.{w} Kalau tidak, dia akan terjaga sepanjang malam."


translate id noel_s02_5cff6341:


    ni "Sayang, buka pintu depan."


translate id noel_s02_a028c83e:


    ni "Saya akan mengurusnya [jason]."


translate id noel_s02_1efffcf7:


    ni "Hati-hati jangan sampai jatuh, trotoarnya sedingin es."


translate id noel_s02_4d2ecd07:


    jen "Jangan khawatir, saya sudah memenuhi salju selama setahun ini."


translate id noel_s02_7c4c9714:


    jen "Saya tidak berencana untuk jatuh lagi!"


translate id noel_s02_f3796da2:


    jenp p "Apa-apaan!"


translate id noel_s02_3c28a102:


    jenp p "Dia tidak pernah melewatkan kesempatan untuk mengambil payudara.{w} Dia adalah seorang perampas payudara!"


translate id noel_s02_299c4125:


    jen "Bu...jangan menyemangati dia!"


translate id noel_s02_72145f6c:


    ni "Ingat apa yang kukatakan padamu di mobil, sayang..."


translate id noel_s02_6f391f32:


    ni "Ayo buka pintunya, dingin sekali."


translate id noel_s03_4a59732f:


    centered "{size=50}{cps=20}{font=RobotoSlab-Bold.TTF}Rabu, Malam Natal 2003{/font}{/cps}{/size}{w=3}{nw}" with dissolve


translate id noel_s03_02d0d643:


    centered "{size=50}{cps=20}{font=RobotoSlab-Bold.TTF}18.17{/font}{/cps}{/size}{w=3}{nw}" with dissolve


translate id noel_s03_a59bdd27:


    nip p "Akhirnya, kesempatan untuk sedikit \'me-time\'!"


translate id noel_s03_308fd771:


    nip p "Pertama, saya akan mengenakan sesuatu yang sedikit lebih nyaman."


translate id noel_s03_b37527b4:


    nip p "Hari ini membuatku lelah."


translate id noel_s03_df4ba3c2:


    nip p "Mmmm! Mereka sangat sensitif saat ini."


translate id noel_s03_f24c015a:


    nip p "Saya kira keajaiban Natal sudah mulai mempengaruhi saya."


translate id noel_s03_cb42cbe6:


    nip p "Saya sudah menantikan ini sejak lama.{p}Saya benar-benar merasa terangsang."


translate id noel_s03_8045e194:


    nip p "Aku bahkan tidak terlalu sering menyentuh putingku dan putingku sudah semakin keras."


translate id noel_s03_355f72fa:


    nip p "Saya pikir saya akan memilih sesuatu dari kotak merah kecil saya sebelum turun untuk membuat makan malam."


translate id noel_s03_204ef5f8:


    nip p "Saya akan memanaskan suasana malam ini sebelum malam dimulai."


translate id noel_s03_9aefb49b:


    nip p "Malam ini adalah malammu..."


translate id noel_s03_dd92bd6f:


    centered "{size=50}{cps=20}{font=RobotoSlab-Bold.TTF}Catatan sejarah.{/font}{/cps}{/size}{w=3}{nw}" with dissolve


translate id noel_s03_8635338e:


