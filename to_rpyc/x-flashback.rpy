translate id flashback_e003202d:


    centered "{size=50}{cps=20}{font=RobotoSlab-Bold.TTF}20:38{/font}{/cps}{/size}{w=3}{nw}" with dissolve


translate id flashback_270dcebf:


    nip p "Sangat penting bagi kita untuk menghabiskan momen spesial ini bersama."


translate id flashback_6ce8917c:


    nip p "Tidak ada yang menghangatkan hati saya seperti menghabiskan Malam Natal bersama anak-anak saya."


translate id flashback_d77471cd:


    nip p "Lalu, setelah mereka tertidur, aku akan menikmati waktu sendirian yang menyenangkan."


translate id flashback_855ce4ef:


    jen "Jadi, apa yang kita tonton malam ini?"


translate id flashback_45b1e847:


    ni "Oh, kamu terlihat sangat cantik malam ini, sayang."


translate id flashback_07b8c70b:


    ni "Keajaiban Natal sepertinya menular pada Anda!"


translate id flashback_d9f62b7c:


    jen "Eh, terima kasih Bu. Kamu juga terlihat sangat cantik malam ini."


translate id flashback_d48426bc:


    jen "Aku selalu menantikan ini...menghabiskan waktu bersamamu di depan TV dengan sweter Natal kita."


translate id flashback_486fe272:


    jen "Dan tentu saja, itu adikku, [jason]."


translate id flashback_aea07a8d:


    jen "Saya berharap malam ini Anda akan tenang dan berperilaku baik?"


translate id flashback_1cb0add6:


    jen "Apa pendapat Anda tentang hal itu, [jason]?"


translate id flashback_1c34c41f:


    ja "Eh, iya, tentu saja, Kak!"


translate id flashback_1c4fe0b0:


    ja "Aku akan menjadi malaikat yang sempurna, seperti biasa."


translate id flashback_3ada70ea:


    jen "Nah, jika tidak, perkirakan Anda akan menerima pukulan!"


translate id flashback_549c6cfc:


    ja "Hei, apakah kamu berkelahi denganku di Malam Natal?"


translate id flashback_4db590e1:


    ja "Dan tepat di depan Ibu juga!"


translate id flashback_a24b68a1:


    ni "Anak-anak, ini bukan waktunya untuk membahasnya!"


translate id flashback_c49f4967:


    jen "Ya, aku juga suka hidup berbahaya, pipsqueak!"


translate id flashback_84a3466d:


    ja "Aku orang yang bodoh?"


translate id flashback_f78cc7cc:


    ja "Silakan, semua itu lagi untukku!"


translate id flashback_67cb2440:


    jen "Orang sepele!"


translate id flashback_351af9fa:


    jen "Kekuatan!"


translate id flashback_92722377:


    ja "Serangan Udara!"


translate id flashback_33543675:


    jen "Apa...?"


translate id flashback_fa2be01a:


    ja "Tidak dapat diblokir!"


translate id flashback_2e7629b8:


    ja "Dia melihat kijang yang sendirian..."


translate id flashback_607ca3de:


    ja "Dan kemudian singa itu menyerang!"


translate id flashback_c35520cd:


    jenp p "Oh no...here we go again!"


translate id flashback_a45e29f1:


    ja "Yaaargh!"


translate id flashback_279e8ec9:


    jen "Tenang, [jason], kamu akan membuatku terjatuh."


translate id flashback_20304f3d:


    ja "Dan sekarang, sebuah gerakan gulat!"


translate id flashback_ffa0049a:


    ja "\'Pembalikan Landasan\'."


translate id flashback_51e10f24:


    nip p "Dia akan terluka!"


translate id flashback_aa346a10:


    jen "Rrrrgh...kenapa kamu bodoh sekali, [jason]?"


translate id flashback_6aba8002:


    ni "Anak-anak! Seseorang akan terluka!"


translate id flashback_453bd224:


    ja "Owww...punggungku!"


translate id flashback_fae77c51:


    ni "Apakah semuanya baik-baik saja, kalian berdua?"


translate id flashback_eb9bd7bf:


    jap p "Uh...tidak juga. Ada apa dengan semua rambut itu?"


translate id flashback_d5c1bfbf:


    jap p "Aku belum pernah melihat bagian kewanitaannya sedekat ini."


translate id flashback_39040cd5:


    jap p "Apakah adikku bagian dari monyet?"


translate id flashback_ed805b68:


    jap p "Aku ingin tahu seperti apa rupa seorang gadis di balik celana dalamnya?"


translate id flashback_823a6615:


    ni "Apakah semuanya baik-baik saja, sayang? Ada yang rusak?"


translate id flashback_18e90686:


    jen "Nah, jangan khawatir Bu, saya fleksibel."


translate id flashback_05d6e7ff:


    jen "Saya rasa inilah yang terjadi jika Anda mengganggu Lion King."


translate id flashback_d8dd966c:


    ni "Dia kuat, singa kecilku."


translate id flashback_81f9334e:


    jen "Saya tidak menyangka akan menemukan diri saya terbaring di lantai sepagi ini!"


translate id flashback_0f7fba36:


    ni "Apa yang terlintas di benakmu hingga menghasut kakakmu saat dia begitu tenang? Anda tentu memintanya kali ini."


translate id flashback_756b5450:


    ja "Apakah kamu melihat, Bu? Aku berhasil melakukan gerakan landasan!"


translate id flashback_c7cc8836:


    ni "Punggungmu bisa saja patah, singa muda!"


translate id flashback_076e94da:


    jen "Mama? Bisakah Anda membantu saya berdiri?"


translate id flashback_459efd00:


    centered "{size=50}{cps=20}{font=RobotoSlab-Bold.ttf}22.36{/font}{/cps}{/size}{w=3}{nw}" with dissolve


translate id flashback_f1270944:


    jen "Bu...bolehkah aku bertanya padamu?"


translate id flashback_9b8efe93:


    ni "Tentu saja, sayang."


translate id flashback_dd0963c3:


    jen "Mengapa kamu selalu begitu bahagia saat Natal?"


translate id flashback_82e178af:


    jen "Saya tahu Anda menyukai waktu-waktu seperti ini, tetapi saya merasa ada hal lain."


translate id flashback_c7004a9a:


    jen "Seolah-olah Anda sedang menantikan sesuatu. Bahkan [jason] tidak begitu bersemangat untuk membuka hadiahnya."


translate id flashback_db63e86a:


    ni "Aku sudah memberitahumu berkali-kali."


translate id flashback_ad9faed5:


    ni "Musim Natal penuh misteri dan keajaiban."


translate id flashback_113a0b7d:


    ni "Saya selalu merasa senang memasuki musim ini."


translate id flashback_5279cfdd:


    ni "Saya merasa seperti melompat kembali ke masa lalu dan menghidupkan kembali masa remaja saya."


translate id flashback_45be6944:


    ni "Saat itu aku riang, sama sepertimu."


translate id flashback_68b8e186:


    ni "Dan juga seperti Anda, saya bersikap sinis terhadap semua kehebohan Natal."


translate id flashback_ead36bde:


    ni "Saya tidak mengerti mengapa semua orang menghabiskan begitu banyak waktu untuk persiapan, hanya untuk melupakannya begitu cepat setelah itu berlalu."


translate id flashback_3c76fb86:


    ni "Hingga malam tanggal 24 Desember 1986."


translate id flashback_3706057b:


    ni "Saya tidak akan pernah melupakan apa yang terjadi malam itu."


translate id flashback_0a9107d0:


    jen "Kamu tidak pernah memberitahuku apa yang terjadi malam itu, Bu."


translate id flashback_d425506d:


    jen "Ayo, beritahu aku!"


translate id flashback_552e2dc1:


    ni "Malam itu, aku bertemu ayahmu, dan malam itu sungguh AJAIB!"


translate id flashback_75e63071:


    ni "Ayahmu tidak ada hubungannya dengan bagian sihir, meskipun benar bahwa berada dalam pelukan seorang pria untuk pertama kalinya mengubahku dari seorang gadis menjadi seorang wanita."


translate id flashback_55896fe9:


    ni "Saya mengetahui bahwa nenek Anda juga mengalami hal serupa pada Natal tertentu."


translate id flashback_572756f7:


    ni "Suatu malam di bulan Desember, ketika kami sendirian, kami membicarakan hal itu."


translate id flashback_34f75d48:


    ni "Dia bercerita tentang Keajaiban Natal."


translate id flashback_8b8955fc:


    ni "Namun baru kemudian saya mengetahui bahwa kami berdua mengalami hal-hal indah pada saat-saat itu."


translate id flashback_32c9ab84:


    ni "Saya yakin Anda juga akan mengalami hal yang sama seperti yang kami alami."


translate id flashback_4839e831:


    ni "Saya akan mengatakannya lagi, malam Natal sungguh ajaib!"


translate id flashback_a3491fb9:


    ni "Dan menurut saya sekarang Anda siap untuk merasakannya sepenuhnya."


translate id flashback_4dbfbc2b:


    jen "Ya, sekarang aku tidak lagi percaya pada Sinterklas, kan?"


translate id flashback_c6d581e1:


    ni "TIDAK! {w}Sekarang Anda telah menjadi...{w}wanita yang cukup muda."


translate id flashback_003c9c77:


    ni "Saya berjanji bahwa semua yang saya katakan kepada Anda adalah benar."


translate id flashback_bc322c8b:


    ni "Jangan menganggapku bodoh."


translate id flashback_e414e9b3:


    ni "Percaya saja sedikit, biarkan diri Anda dibimbing oleh melodi kecil ini, dan Anda akan melihat bahwa segalanya akan berbeda besok."


translate id flashback_f6773697:


    jen "Sebuah melodi?"


translate id flashback_7f1c2ace:


    jen "Saya tidak tahu apakah itu melodi yang sedang Anda bicarakan, tapi saya mendengar banyak hal saat saya sendirian."


translate id flashback_c9ebfe95:


    jen "Dan jika saya membiarkan diri saya diliputi oleh suara-suara ini, mereka berubah menjadi gambar, dan beberapa detik kemudian, saya merasa seperti berada di dunia lain atau kenyataan lain."


translate id flashback_7ec0c61b:


    ni "Tampaknya semua wanita di keluarga kami memiliki karunia ini."


translate id flashback_5fa81dce:


    ni "Tapi saya tidak pernah bisa menggunakannya di luar musim Natal."


translate id flashback_edf66778:


    ni "Ibu sering berkata bahwa kekuatan melampaui satu generasi."


translate id flashback_a44a6f4b:


    ni "Punyaku berkurang, milikmu tinggal menunggu untuk dikuasai!"


translate id flashback_30ae7dc8:


    jen "Kamu tidak pernah memberitahuku tentang ini."


translate id flashback_7b74b110:


    jen "Kenapa malam ini?"


translate id flashback_b31695a3:


    ni "Aku merasa kamu sudah siap sekarang, sayang."


translate id flashback_5ab35c28:


    ni "Dan Anda perlu belajar bagaimana memanfaatkannya semaksimal mungkin, dan mewariskannya kepada anak-anak Anda."


translate id flashback_5d002229:


    jen "Tunggu, tunggu! Tidak secepat itu, Bu!"


translate id flashback_7538bd42:


    jen "Saya rasa saya belum siap memikirkan untuk memiliki anak."


translate id flashback_640ae2a1:


    jen "Apalagi jika mereka mewarisi gen 'menjengkelkan' adikku."


translate id flashback_b7a9ae7e:


    ni "Putriku, secantik apapun dirimu, aku tidak mengkhawatirkan garis keturunan kita."


translate id flashback_923bffbc:


    ni "Kita semua menyebalkan ketika kita masih kecil, dan hal itu selalu berlalu...pada akhirnya."


translate id flashback_7da584a5:


    ni "Ketika kamu punya anak sendiri, kamu akan menjadikanku seorang nenek yang bahagia. Saya tidak meragukannya."


translate id flashback_86768321:


    jen "Ha, oke, aku akan melakukan yang terbaik, aku janji."


translate id flashback_79396ff5:


    jen "Silangkan hatiku, berharap mati, tusukkan jarum ke mataku!"


translate id flashback_16ef1fb0:


    jen "Tapi serius, Bu, kalau soal anak, jangan terlalu berharap banyak. Saya tidak tahu apakah itu akan terjadi."


translate id flashback_a355e6f6:


    jenp p "Aku bahkan tidak tahu apakah aku menyukai laki-laki!"


translate id flashback_265455c3:


    jap p "Hmm, menarik!"


translate id flashback_d230413b:


    jap p "Sebelumnya, Ibu berbicara tentang Sinterklas, dan sekarang dia berbicara tentang kekuatan magis?"


translate id flashback_fea7c4c1:


    jap p "Malam Natal ini sangat ideal untuk investigasi gaya [jason]."


translate id flashback_75a03935:


    centered "{size=50}{cps=20}{font=RobotoSlab-Bold.ttf}23.36{/font}{/cps}{/size}{w=3}{nw}" with dissolve


translate id flashback_52671905:


    ni "Sepertinya Anda semua kesiangan karena berguling-guling di salju sepanjang hari."


translate id flashback_781bbf27:


    ni "Mimpi indah, cintaku. Saya yakin Sinterklas akan memanjakan Anda lagi tahun ini."


translate id flashback_577fa4e2:


    ni "Tidur nyenyak, dan jangan bangun terlalu pagi besok pagi."


translate id flashback_647c47ab:


    nip p "Biarkan aku tidur, aku akan membutuhkannya."


translate id flashback_9cfb3f2d:


    ni "Apa? Kamu belum tidur?"


translate id flashback_e040c909:


    ja "Bu...apakah Santa Claus benar-benar ada?"


translate id flashback_70afaad9:


    ja "Jen terus mengatakan dia tidak nyata!"


translate id flashback_0bd5c0fd:


    ni "Tentu saja, dia nyata, sayang."


translate id flashback_c6568e2d:


    ni "Jangan dengarkan kakak perempuanmu; dia hanya mengatakan itu untuk mengganggumu."


translate id flashback_44a21d80:


    ni "Ayo tidur, karena kalau tidak tidur dia tidak akan datang!"


translate id flashback_7de1a34c:


    ja "Aku terlalu lelah!"


translate id flashback_128c243a:


    ja "Bisakah kamu membiarkan lampunya menyala sebentar?"


translate id flashback_b1c81e06:


    ni "Tentu saja. Saya akan mengganti piyama saya dan kembali untuk mematikannya."


translate id flashback_78cc5048:


    ni "Tidur nyenyak, bidadariku."


translate id flashback_6fb50f6e:


    centered "{size=50}{cps=20}{font=RobotoSlab-Bold.ttf}23.59{/font}{/cps}{/size}{w=3}{nw}" with dissolve


translate id flashback_cfd0fe02:


    nip p "Tidak butuh waktu lama baginya untuk tertidur."


translate id flashback_5f7d1df6:


    nip p "Setiap Natal selalu sama. Ia ingin tetap terjaga sepanjang malam, namun kelelahan selalu menang pada akhirnya."


translate id flashback_9c2ce54b:


    nip p "Mimpi indah, Nak."


translate id flashback_c0224561:


    nip p "Aku mencintaimu!"


translate id flashback_832613c1:


    nip p "Sekarang dimulailah fase dewasa malam itu, akhirnya."


translate id flashback_423245a1:


    nip p "Saya sudah menunggu ini begitu lama."


translate id flashback_bef46dda:


    nip p "Saya menghilangkan diri saya sepanjang tahun untuk saat ini."


translate id flashback_81bc4b74:


    nip p "Saya sangat bersemangat."


translate id flashback_84de41f3:


    nip p "Saya meminum pil saya; Saya tidak mampu untuk hamil lagi."


translate id flashback_02fd4864:


    nip p "Saya terlalu tua untuk memiliki anak lagi."


translate id flashback_1fe63b9d:


    jap p "Kapten [jason], pantainya bersih."


translate id flashback_cc3d797e:


    jap p "Misi ini bukanlah yang termudah dalam karir muda saya sebagai kapten luar angkasa."


translate id flashback_8944ed1b:


    jap p "Tapi aku harus yakin. Jika Sinterklas memang ada, saya harus membuka kedoknya."


translate id flashback_06d30300:


    jap p "Takutlah, Tuan Claus, Kapten [jason] akan datang!"


translate id flashback_dc090b4f:


    jap p "Yang paling penting adalah menunggu semua orang tertidur. Begitu suasana sepi, aku akan menelusuri setiap sudut rumah."


translate id flashback_fcee92fe:


    jap p "Misi ini tidak boleh berakhir dengan kegagalan!"


translate id flashback_d3e525d6:


    jap p "Saya telah merencanakan semuanya dengan sempurna."


translate id flashback_9bcf918b:


    jap p "Dan saya bahkan berpikir untuk mengganti baterai detektor gerakan SPX3000 saya."


translate id flashback_16239cb5:


    jap p "Kapten [jason], ini EVA, Augmentasi Ekstra-Kendaraan Anda."


translate id flashback_494120f3:


    jap p "Kapasitor kapal berada pada 100%%. Semua sistem adalah Go."


translate id flashback_a51d3aa9:


    jap p "Kapten, saya harus memberi tahu Anda bahwa jika terjadi kejadian negatif, perhitungan probabilitas saya untuk ekstraksi tanpa hambatan dari planet ini adalah 98%%."


translate id flashback_7fe2c67a:


    jap p "10-4, pesan diterima EVA! Beri aku gambaran sekilas tentang kamar Jen dan Ibu. Saya harus memastikan mereka tertidur lelap."


translate id flashback_57d7af42:


    jap p "Kapten, pembacaan detak jantung dari dua spesimen wanita menunjukkan keadaan tertidur lelap."


translate id flashback_931a8020:


    jap p "Semoga beruntung, Kapten!"


translate id flashback_45ad77c8:


    jap p "Aneh! Pembacaan ini sangat tidak normal. Seolah-olah sesuatu yang tidak wajar sedang terjadi!"


translate id flashback_ad8e2240:


    jap p "Sepertinya sinyal yang datang dari pintu Jen semakin terdistorsi."


translate id flashback_d1f632bf:


    jap p "Saya tidak dapat memahami pengukuran ini."


translate id flashback_3e1d45ba:


    jap p "EVA, perlu analisis data secara menyeluruh. Transfer data sedang berlangsung, namun sepertinya sinyalnya kacau."


translate id flashback_5f04dcc8:


    jap p "Menerima data, Kapten.{w} Analisis saya menunjukkan bahwa subjek bernama [jennifer] sedang...{w}mendengkur!"


translate id flashback_9eb31a36:


    jap p "Salin itu, EVA."


translate id flashback_0db5e1b2:


    jap p "Hal ini sesuai dengan penelitian saya."


translate id flashback_72a6550c:


    jap p "Spesies gadis ini dikenal suka mengeluh di siang hari dan mendengkur di malam hari. Itu sudah diperiksa."


translate id flashback_4517216d:


    jap p "Saya akan melanjutkan rencana saya, EVA. Aku sudah melihat kamar berikutnya. Dari pemindaian kami sebelumnya, kami yakin ruangan ini adalah sarang ibu suri."


translate id flashback_5ede1a09:


    jap p "Saya dalam posisi."


translate id flashback_a3494705:


    jap p "Saya mendengar suara-suara! Seperti mengerang."


translate id flashback_57c0c0d7:


    jap p "Sensornya menjadi gila saat saya mendekati pintu dengan detektor gerakan. Saya belum pernah melihat ini sebelumnya!"


translate id flashback_d143bc51:


    jap p "Sungguh luar biasa! Segera meminta saran!"


translate id flashback_c2614b30:


    jap p "Kapten, setelah menganalisis data, saya tidak dapat menafsirkan sinyal yang diterima."


translate id flashback_4f569bd0:


    jap p "Tindakan terbaik adalah Anda memasuki sarang ibu dan mendapatkan konfirmasi visual."


translate id flashback_4366f152:


    jap p "Apa? Konfirmasikan rekomendasi, EVA!"


translate id flashback_a8eba0e7:


    jap p "Rekomendasi dikonfirmasi, Kapten."


translate id flashback_c5dcd334:


    jap p "Tapi dia akan membentakku jika dia menangkapku!"


translate id flashback_b8db0965:


    jap p "Tanggung jawab yang besar membawa bahaya yang besar, Kapten!"


translate id flashback_e3eff075:


    jap p "Sialan!"


translate id flashback_0f4b084f:


    jap p "Cahaya agak kemerahan memancar dari ruangan."


translate id flashback_276e76b1:


    jap p "Apa itu?"


translate id flashback_c3bbef74:


    jap p "Apa yang terjadi?"


translate id flashback_ecc93ccd:


    jap p "Ini tidak terduga."


translate id flashback_a5c76ccc:


    jap p "..."


translate id flashback_10cd0bcb:


    jap p "Sulit dipercaya!"


translate id flashback_23348882:


    pn "Jadi, [jason]...bermain mata-mata sekarang, kan?"


translate id flashback_b874c130:


    ja "Oh tidak!"


translate id flashback_9682688d:


    ja "Permintaan ekstraksi darurat, Kode 4."


translate id flashback_83d7cb6f:


    ja "EVA, bisakah kamu mendengarku? Ada pencuri di rumahku!"


translate id flashback_cab7018e:


    ja "EVA?"


translate id flashback_e71d9881:


    ja "Itu tidak mungkin!"


translate id flashback_406ba4bb:


    ja "Sinterklas tidak ada."


translate id flashback_778dabae:


    pn "Jadi, [jason]? Merasa sedikit kurang percaya diri sekarang, ya?"


translate id flashback_d86c47b0:


    pn "Tunggu! Jangan pergi secepat ini!"


translate id flashback_31e872f6:


    jap p "[jason], tenangkan dirimu. Anda memiliki semua perlengkapan, dan dia bahkan tidak bersenjata!"


translate id flashback_31d5b788:


    pn "Kamu pikir kamu bisa mengejutkanku dengan mudah?"


translate id flashback_5f6e2ff3:


    pn "Anda tahu, Anda bukan orang pertama yang mencoba."


translate id flashback_16c41714:


    ja "Jangan mendekat, atau aku akan menembak!"


translate id flashback_eca9ad5d:


    ja "Katakan padaku sekarang, apa yang kamu lakukan di kamar Ibu?"


translate id flashback_323bb980:


    pn "Oh! Anda benar-benar ingin tahu?"


translate id flashback_0f96b2f3:


    pn "Saya secara pribadi mengirimkan hadiah yang dia pesan."


translate id flashback_3caf18d1:


    ja "Kamu berbohong!"


translate id flashback_8e08637c:


    ja "Ambil ini, gendut!"


translate id flashback_1196de35:


    pn "Astaga! Dia baru saja menutup mataku."


translate id flashback_c1cf7460:


    jap p "EVA, beri aku lintasan. Saya meluncurkan hulu ledak nuklir!"


translate id flashback_d0a847be:


    jap p "API!"


translate id flashback_d6c262e6:


    jap p "Kehancuran dalam 2...1..."


translate id flashback_ec2e59ed:


    jap p "Dampak!"


translate id flashback_57bba402:


    pn "Oof...persetan denganku!"


translate id flashback_6131baae:


    jap p "Terlalu mudah untuk menghilangkan lemak lama itu."


translate id flashback_5810176a:


    jap p "Jika itu benar-benar Sinterklas, maka rusa kutubnya pasti tidak jauh dari sana!"


translate id flashback_9d235cd0:


    jap p "Saya harus yakin."


translate id flashback_b45f069d:


    jap p "Apa?? Saya tidak percaya apa yang saya lihat!"


translate id flashback_4e9ac730:


